      "parameters": {
        "operation": "executeQuery",
        "query": "select bp.profile_id, bp.channel, bp.app_user_id\nfrom bot_profiles bp\nleft join subscribers s on s.app_user_id = bp.app_user_id\nwhere bp.deleted_at is null\n  and bp.created_at < now() - interval '1 hour'\n  and coalesce(s.status, 'none') <> 'active';",
