    {
      "id": "8d83ea55-a7a1-4362-b6cd-d41766f3c9ea",
      "name": "Compute Liveness Diff",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        160,
        320
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "function validateBase(resp) {\n  if (!resp || resp.error) return { ok: false, reason: 'fetch_error: ' + JSON.stringify(resp && resp.error) };\n  if (resp.status !== 'done') return { ok: false, reason: 'bad_status: ' + JSON.stringify(resp && resp.status) };\n  const profiles = (resp.profiles === null || resp.profiles === undefined) ? [] : resp.profiles;\n  if (!Array.isArray(profiles)) return { ok: false, reason: 'profiles_not_array' };\n  return { ok: true, profiles: profiles };\n}\n\nconst waResp = $('List WA Profiles').first().json;\nconst tgResp = $('List TG Profiles').first().json;\nconst waCheck = validateBase(waResp);\nconst tgCheck = validateBase(tgResp);\n\nconst rows = $input.all().map(function (i) { return i.json; });\n\n// Empty-list floor (review C2, guard 2): a well-formed but EMPTY live list, while the\n// registry holds >=1 alive row for that channel, is treated the SAME as an invalid\n// fetch -- skip, never mass-retire on a suspicious-looking empty response. Mirrors the\n// orphan sweep's own \"never delete on ambiguity\" philosophy; without this, a genuinely\n// wrong-but-well-formed empty response would retire EVERY alive row for that channel in\n// one pass -- the exact fail-dangerous polarity flip the orphan sweep avoids.\nconst registryCountByChannel = {};\nfor (const row of rows) {\n  registryCountByChannel[row.channel] = (registryCountByChannel[row.channel] || 0) + 1;\n}\n\nfunction applyEmptyListFloor(check, channel) {\n  if (!check.ok) return check;\n  if (check.profiles.length === 0 && (registryCountByChannel[channel] || 0) > 0) {\n    return { ok: false, reason: 'empty_list_floor: live list empty but registry holds ' + registryCountByChannel[channel] + ' alive row(s)' };\n  }\n  return check;\n}\n\nconst waFinal = applyEmptyListFloor(waCheck, 'whatsapp');\nconst tgFinal = applyEmptyListFloor(tgCheck, 'telegram');\n\nconst liveSets = {};\nif (waFinal.ok) { liveSets.whatsapp = new Set(waFinal.profiles.map(function (p) { return String(p.profile_id || '').trim(); })); }\nif (tgFinal.ok) { liveSets.telegram = new Set(tgFinal.profiles.map(function (p) { return String(p.profile_id || '').trim(); })); }\n\nconst baseValid = { whatsapp: waFinal.ok, telegram: tgFinal.ok };\nconst baseSkipReason = { whatsapp: waFinal.ok ? null : waFinal.reason, telegram: tgFinal.ok ? null : tgFinal.reason };\n\nreturn rows.map(function (row) {\n  const channel = row.channel;\n  let action, reason;\n  if (!baseValid[channel]) {\n    action = 'skip_invalid_fetch';\n    reason = baseSkipReason[channel];\n  } else if (liveSets[channel] && liveSets[channel].has(String(row.profile_id || '').trim())) {\n    action = 'keep';\n    reason = null;\n  } else {\n    action = 'retire';\n    reason = 'liveness';\n  }\n  return { json: Object.assign({}, row, { action: action, reason: reason, baseValid: baseValid[channel] }) };\n});"
      }
    },
