        "jsCode": "const j = $input.first().json;\nconst b = j.body || {};\nconst s = v => (typeof v === 'string' ? v.trim() : '');\nconst website = s(b.website);\nconst phone = s(b.phone);\nconst name = s(b.name).slice(0, 80);\nconst source = (s(b.source) || 'landing').slice(0, 40);\nconst ua = s((j.headers || {})['user-agent']).slice(0, 200);\n// Цифры считаем отдельно от charset-проверки: '((((((' и '++++++' проходили длину и набор\n// символов, но телефоном не являются. КЗ-номер = 11 цифр, 15 — максимум по E.164.\nconst digits = (phone.match(/\\d/g) || []).length;\nlet action;\nif (website) action = 'silent';\nelse if (!phone || phone.length < 6 || phone.length > 32 ||\n         !/^[0-9+()\\-\\s]+$/.test(phone) || digits < 10 || digits > 15) action = 'bad';\nelse action = 'insert';\nreturn [{ json: { action, name, phone, source, ua } }];"
      },
