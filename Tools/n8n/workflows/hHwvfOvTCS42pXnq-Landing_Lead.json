      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "-- Дешёвый предохранитель для НЕаутентифицированного эндпоинта: вставка происходит только\n-- пока за последнюю минуту записей меньше 10. Живой посетитель этого порога не достигает,\n-- а флуд не забивает таблицу, которую владелец читает глазами. Ответ остаётся {success:true}.\ninsert into landing_leads (name, phone, source, user_agent)\nselect nullif($1,''), $2, $3, nullif($4,'')\nwhere (select count(*) from landing_leads where created_at > now() - interval '1 minute') < 10;",
        "options": {
